# Project Germania environment template
LOG_LEVEL=INFO
LOG_FILE=logs/germania.log
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed
EXPORT_DATA_DIR=data/exports
REQUEST_TIMEOUT=30
MAX_REQUESTS_PER_RUN=100
PLAYWRIGHT_HEADLESS=true

# Dashboard defaults to Production Mode. Set true only for the public demo bundle.
DEMO_MODE=false

# Production Dashboard/AI live external intelligence. Demo Mode always disables
# live network providers and uses the bundled validated Content Feed.
LIVE_EXTERNAL_INTELLIGENCE=true

# AI Agent defaults to the deterministic local evidence rules. Future provider
# adapters can use these environment variables; never commit real API keys.
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides. Defaults are used when these are left empty.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Reserved for the later database phase. Do not put real secrets in this file.
DATABASE_URL=
GERMANIA_DATABASE_URL=
